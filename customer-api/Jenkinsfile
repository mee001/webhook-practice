pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'qa', 'prod'], description: 'Select deployment environment')
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout stage: Checking out source-code from SCM...'
            }
        }

        stage('Build') {
            steps {
                script {
                    // Task 2: GROOVY Variables definition
                    def appName = "customer-api"
                    def version = "1.0.0"

                    echo "Application name: ${appName}"
                    echo "Version: ${version}"
                    echo "Selected Environment (from parameter): ${params.ENVIRONMENT}"

                    // Task 4: Process multiple environments in a GROOVY list.
                    def environments = ['dev', 'qa', 'prod']
                    environments.each { envItem ->
                        echo "Processing environment: ${envItem}"
                    }
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage: Tests have started...'
            }
        }

        stage('Deploy') {
            steps {
                script {
                    // Task 5: Use of PARAMETERS for passing values.
                    def selectedEnv = params.ENVIRONMENT

                    if (selectedEnv == 'dev') {
                        echo 'Development deployment started.'
                    } else if (selectedEnv == 'qa') {
                        echo 'QA deployment started.'
                    } else if (selectedEnv == 'prod') {
                        echo 'Production deployment requires approval.'
                    } else {
                        error("Unknown environment: ${selectedEnv}. Pipeline failed.")
                    }
                }
            }
        }
    }
}
